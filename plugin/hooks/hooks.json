{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "npx -y bluet-mcp@latest hook session-start", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "npx -y bluet-mcp@latest hook stop", "timeout": 30 }
        ]
      }
    ]
  }
}
